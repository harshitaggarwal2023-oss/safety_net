# Copy this file to `.env` for your own reference (Safety Net is a static
# site with no build step, so nothing here is auto-loaded by the browser —
# see env.js.example for how these actually reach the app).
#
# NONE of these are required. With no values set, Safety Net sends the SOS
# alert via a mailto: (or sms:) link, which needs no keys and no backend.

# EmailJS — a client-safe public key that lets a static page send real email
# without a server. Get these from your EmailJS dashboard.
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=

# ponytail: Twilio is intentionally NOT wired up client-side. Its auth token
# is a secret — putting "TWILIO_*" values in browser-loadable code would ship
# that secret to every visitor. Ceiling: no real SMS send today beyond the
# native `sms:` link fallback in app.js. Upgrade path: add a small
# serverless/backend function (Vercel/Netlify/etc.) that holds TWILIO_* in
# server-side env vars and exposes one endpoint, e.g. POST /api/sms, for
# app.js's sendAlert() to call instead of the sms: link.
