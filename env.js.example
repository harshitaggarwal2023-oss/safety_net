// OPTIONAL — enables real EmailJS sending instead of the mailto:/sms: fallback.
//
// ponytail: browsers can't read process.env / .env files directly (there's
// no build step here). This file is the practical stand-in for "environment
// variables available to the app": copy it to env.js, fill in real values,
// and env.js (gitignored) becomes window.SAFETY_NET_ENV at runtime. Ceiling:
// this is manual, per-machine config, not a real env-var pipeline. Upgrade
// path: if this project ever gets a build step or a host with env-var
// injection (Netlify/Vercel), generate env.js from real env vars at deploy
// time instead of hand-copying this file.
//
// Steps to enable:
//   1. cp env.js.example env.js
//   2. fill in the three values below from your EmailJS dashboard
//   3. uncomment the <script src="env.js"></script> line in index.html
// env.js is in .gitignore — never commit it with real values filled in.

window.SAFETY_NET_ENV = {
  EMAILJS_SERVICE_ID: "",
  EMAILJS_TEMPLATE_ID: "",
  EMAILJS_PUBLIC_KEY: "",
};
